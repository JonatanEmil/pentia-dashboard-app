{
  "plugin": ["typedoc-plugin-vue"],
  "projectDocuments": ["./docs-src/markdown/**/*.md"],
  "excludeVueProperties": true,
  "entryPoints": [
    "./src/stores",
    "./src/composables",
    "./src/utils"
  ],
  "entryPointStrategy": "expand",
  "excludeExternals": true,
  "excludeNotDocumented": true,
  "tsconfig": "./tsconfig.json",
  "out": "docs"
}